# Payload CMS (Phase 3+)
DATABASE_URI=
# Local Mongo for dev; source for `npm run db:migrate:local-to-prod`
LOCAL_DATABASE_URI=mongodb://127.0.0.1:27017/qbitlog
# Optional explicit Atlas/prod target (defaults to DATABASE_URI)
# PROD_DATABASE_URI=
# If Node fails with querySrv ECONNREFUSED, use public DNS for SRV resolution:
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1
PAYLOAD_SECRET=
PREVIEW_SECRET=
# Bearer token for the Payload jobs runner (scheduled publish cron)
CRON_SECRET=
# Vercel Blob (media + résumés). Vercel injects this when a Blob store is linked to the project;
# for local dev copy it from the store's settings or run `vercel env pull`. Unset = local disk.
BLOB_READ_WRITE_TOKEN=

# Email (Zoho SMTP)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_MAIL_USER=
ZOHO_MAIL_APP_PASSWORD=
EMAIL_FROM=
LEADS_NOTIFY_TO=
CAREERS_NOTIFY_TO=
CAREERS_FROM_EMAIL=
CAREERS_TO_EMAIL=
# "true" = lead/application hooks log a one-line dry run instead of sending
EMAIL_DRY_RUN=

# Spam protection (optional)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
