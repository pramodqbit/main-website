{
	"name": "qbitlog-website",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbopack --port 3001",
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --turbopack",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3001",
		"lint": "eslint",
		"typecheck": "tsc --noEmit",
		"check": "npm run lint && npm run typecheck && npm run build",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"generate:types": "npm run payload generate:types",
		"generate:importmap": "npm run payload generate:importmap",
		"seed": "cross-env NODE_OPTIONS=--no-deprecation tsx cms/seed/index.ts",
		"seed:verify": "cross-env NODE_OPTIONS=--no-deprecation tsx cms/seed/verify.ts",
		"seed:publish-drafts": "cross-env NODE_OPTIONS=--no-deprecation tsx cms/seed/publish-drafts.ts",
		"seed:enable-phase8-sections": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/enable-phase8-index-sections.ts",
		"db:migrate:local-to-prod": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-local-to-prod.ts",
		"media:migrate-to-blob": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/migrate-media-to-blob.ts",
		"test:e2e": "playwright test",
		"docs:screenshots": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/editor-guide-screenshots.ts",
		"analyze": "cross-env ANALYZE=true npm run build",
		"prepare": "husky"
	},
	"dependencies": {
		"@fontsource/geist-mono": "^5.3.0",
		"@fontsource/source-serif-4": "^5.3.0",
		"@payloadcms/db-mongodb": "3.90.2",
		"@payloadcms/email-nodemailer": "3.90.2",
		"@payloadcms/live-preview-react": "3.90.2",
		"@payloadcms/next": "3.90.2",
		"@payloadcms/plugin-redirects": "3.90.2",
		"@payloadcms/plugin-seo": "3.90.2",
		"@payloadcms/richtext-lexical": "3.90.2",
		"@payloadcms/storage-vercel-blob": "3.90.2",
		"@payloadcms/ui": "3.90.2",
		"@vercel/analytics": "^1.5.0",
		"@vercel/speed-insights": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"graphql": "16.14.2",
		"lenis": "^1.3.26",
		"lucide-react": "^0.544.0",
		"next": "^16.3.6",
		"payload": "3.90.2",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"server-only": "^0.0.1",
		"sharp": "0.35.4",
		"tailwind-merge": "^3.3.1",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/eslintrc": "^3",
		"@next/bundle-analyzer": "^16.3.6",
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4",
		"@tailwindcss/typography": "^0.5.20",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"cross-env": "^10.1.0",
		"dotenv": "^18.0.3",
		"eslint": "^9",
		"eslint-config-next": "^16.3.6",
		"husky": "^9.1.7",
		"jsdom": "^30.1.1",
		"tailwindcss": "^4",
		"tsx": "^4.23.15",
		"typescript": "^5",
		"wait-on": "^9.1.0"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
